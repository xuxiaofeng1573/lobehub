{
  "installCommand": "bun install",
  "buildCommand": "disable_telemetry=1 NODE_OPTIONS='--max-old-space-size=8192' next build",
  "env": {
    "NEXT_PUBLIC_SERVICE_MODE": "client",
    "GENERATE_SOURCEMAP": "false",
    "NEXT_TELEMETRY_DISABLED": "1",
    "WEBPACK_WORKER_COUNT": "1",
    "CPUS": "1",
    "NEXT_MINIFIER_DISABLED": "false"
  }
}
